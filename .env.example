PORT=3000
SERVER_PORT=5001
# Free Yahoo Finance market data and news are built-in and require no API key.
# Optional: Add an external API key from https://newsapi.org or RapidAPI for additional news wire stories.
NEWS_API_KEY=your_news_api_key_here
YAHOO_API_KEY=

# Razorpay Payment Gateway (Test or Live API Keys from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
